# Variables de entorno para el MCP server
# Copiar a .env (o configurar en Arcane "Env Content" al crear el stack).

# API key de Arcane. Crear en Arcane: Settings > API Keys.
# Copiar el valor (formato "arc_...") que se muestra SOLO al crearla.
ARCANE_API_KEY=arc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL base de Arcane.
# - Si el MCP corre en la misma VM que Arcane: http://localhost:3552
# - Si corre en otra máquina: http://192.168.180.210:3552
ARCANE_BASE_URL=http://localhost:3552

# Bearer token para autenticar clientes MCP (Claude Desktop/Code).
# Generar con: openssl rand -hex 32
MCP_AUTH_TOKEN=cambia-esto-por-un-token-aleatorio-de-256-bits
